# demo: exemplos fictícios, sem contas nem banco. supabase: dados reais, sem fallback.
APP_MODE=demo
# Deploy acadêmico: false. true somente para testar os fluxos locais com Mailpit.
# Sem esta variável, cadastro/recuperação/confirmação ficam desativados.
AUTH_EMAIL_FLOWS_ENABLED=false
# URL canônica da aplicação (inclua a porta local; sem barra final).
APP_URL=http://127.0.0.1:3000
# Preencha localmente. Nunca use service_role ou sb_secret_* nesta variável.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
